\newcommand{\thanksframe}[2]{%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture, overlay]
      \fill[defense-navy] (current page.north west) rectangle
        ([yshift=-0.12cm]current page.north east);
      \fill[defense-navy] ([yshift=0.12cm]current page.south west) rectangle
        (current page.south east);
    \end{tikzpicture}
    \vbox to \paperheight\bgroup
      \vskip0.6cm
      \begin{center}
        {\color{defense-navy}\sffamily\fontsize{12pt}{14pt}\selectfont\addfontfeature{LetterSpace=20.0}THANK YOU}
      \end{center}
      \vfill
      \begin{center}
        {\color{defense-gold}\rule{1.6cm}{0.6pt}\hspace{0.5cm}\raisebox{0.18em}{$\bullet$}\hspace{0.5cm}\rule{1.6cm}{0.6pt}}\\[0.6cm]
        {\color{defense-navy}\sffamily\fontsize{26pt}{34pt}\selectfont\mdseries #1}\\[0.5cm]
        {\color{textgray}\sffamily\fontsize{10pt}{12pt}\selectfont #2}
      \end{center}
      \vskip1.0cm
    \egroup
  \end{frame}
}

