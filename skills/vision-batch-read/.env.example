# 多模态读图 LLM 配置
# 复制本文件为 .env(已被 gitignore),填入真实值。
# 也可不建 .env,直接 export 这些环境变量。

# OpenAI 兼容的 API key
VISION_API_KEY=your_api_key_here

# API base,到 /v2 或 /v1 这层,脚本会自动拼 /chat/completions
VISION_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2

# 多模态模型名(必须支持 image_url 输入)
VISION_MODEL=xopqwen35v35b

# 可选:回退到通用 OPENAI_* 变量(脚本找不到 VISION_* 时用)
# OPENAI_API_KEY=...
# OPENAI_API_BASE=...
# OPENAI_MODEL=...
